
plugin zep_sound;

// which sounddevice to use
const string DEVICE = "device";
const string D = "d";

// The number of channels to use
const string CHANNELS = "num-channels";
const string C = "n";

// The number of loops if negative pretty much infinitive
const string L = "l";
const string LC = "loopcount";

int device_num = -1;
int option_num_channels = 1;

int num_loops = 2;

init() {

    // The desired sound device
    if (have_option(DEVICE)) {
        device_num = int(option_value(DEVICE));
    }
    if (have_option(D)) {
        device_num = int(option_value(D));
    }

    // The number of channels
    if (have_option(CHANNELS)) {
        option_num_channels = int(option_value(CHANNELS));
    }
    if (have_option(C)) {
        option_num_channels = int(option_value(C));
    }

    // The number of times you want to go through the channels.
    if (have_option(L)) {
        num_loops = int(option_value(L));
    }
    if (have_option(LC)) {
        num_loops = int(option_value(LC));
    }
}

SoundPlaybackDevice sound_output_device
{
    init()
    {
        println("Opening device " + device_num);
        println("Opening num_channels = " + option_num_channels + " 48000 hz ");
        open(option_num_channels, 48000, device_num, 0ms);
        if (error()) terminate;
    }
}


SoundPlayback playback
{
    int nth_channel;
    int nth_loop;

    init()
    {
        nth_channel = 0;
        nth_loop = 0;
        device = sound_output_device;
        num_channels = option_num_channels;
        scaling_all = 1.0;
    }

    SoundFile clip
    {
        init()
        {
            file = "./sounds/zero.wav";
        }
    }

    finish() {
        println("Sound finished");
        nth_channel = nth_channel + 1;
        if (nth_channel >= option_num_channels) {
            nth_channel = 0;
            nth_loop = nth_loop + 1;
            if (nth_loop == num_loops)
                terminate;
        }
       play(event_time + 1s);
    }

    void play(time t) {
        string dir = "./sounds/";

        scaling_all = 0.0; // silence all channels
        scaling[this.nth_channel] = 1.0; // make nth_channel audible.

        int i;
        while (i < num_channels) {
            print("channel " + i + ": " + scaling[i] + "\t");
            i++;
        }
        println();

        println("nth_channel = " + this.nth_channel);

        if (nth_channel == 0) {
            clip.file = dir + "zero.wav";
        }
        else if (nth_channel == 1){
            clip.file = dir + "one.wav";
        }
        else if (nth_channel == 2){
            clip.file = dir + "two.wav";
        }
        else if (nth_channel == 3){
            clip.file = dir + "three.wav";
        }
        else if (nth_channel == 4){
            clip.file = dir + "four.wav";
        }
        else if (nth_channel == 5){
            clip.file = dir + "five.wav";
        }
        else if (nth_channel == 6){
            clip.file = dir + "six.wav";
        }
        else if (nth_channel == 7){
            clip.file = dir + "seven.wav";
        }
        else if (nth_channel == 8){
            clip.file = dir + "eight.wav";
        }
        else if (nth_channel == 9){
            clip.file = dir + "nine.wav";
        }
        playback.start(t);
    }
}


start()
{
    // The motu seems slow to start...
    playback.play(event_time + 5s);
}
